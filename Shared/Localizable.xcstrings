    "state.streaming.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege den Zeiger über den Bildschirmrand hinaus, um ihn zu erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the pointer past the screen edge to reach it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el puntero más allá del borde de la pantalla para llegar a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez le pointeur au-delà du bord de l'écran pour y accéder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta il puntatore oltre il bordo dello schermo per raggiungerlo."
          }
        }
      }
    },
    "state.streaming.title": {
