    "step.cable.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende ein Datenkabel und lass das iPhone entsperrt. Nur einmal nötig – danach funktioniert auch WLAN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a data cable and keep your iPhone unlocked. Needed once; afterwards Wi-Fi works too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un cable de datos y mantén el iPhone desbloqueado. Solo la primera vez: después también funciona el Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un câble de données et gardez l'iPhone déverrouillé. Une seule fois : ensuite le Wi-Fi fonctionne aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un cavo dati e tieni l'iPhone sbloccato. Serve una volta sola: poi funziona anche il Wi-Fi."
          }
        }
      }
    },
