{
  "sourceLanguage": "en",
  "strings": {
    "about.app.cleanmacjoe": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigung von Caches, Duplikaten und großen Dateien. Vollständige App-Deinstallation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache, duplicate and large-file cleanup. Complete app uninstallation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpieza de cachés, duplicados y archivos grandes. Desinstalación completa de apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyage des caches, doublons et gros fichiers. Désinstallation complète des apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulizia di cache, duplicati e file grandi. Disinstallazione completa delle app."
          }
        }
      }
    },
    "about.app.joenote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen, Checklisten und Erinnerungen mit planbaren Benachrichtigungen, Themen und Widgets."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes, checklists and reminders with scheduled notifications, themes and widgets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas, listas y recordatorios con notificaciones programables, temas y widgets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes, listes et rappels avec notifications programmables, thèmes et widgets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Note, checklist e promemoria con notifiche programmabili, temi e widget."
          }
        }
      }
    },
    "about.app.klipzen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoschnitt, Filter und automatische Untertitel. Export für Social Media und YouTube."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video editing, filters and automatic subtitles. Export for social media and YouTube."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edición de vídeo, filtros y subtítulos automáticos. Exportación para redes sociales y YouTube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montage vidéo, filtres et sous-titres automatiques. Export pour les réseaux sociaux et YouTube."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Montaggio video, filtri e sottotitoli automatici. Esportazione per social e YouTube."
          }
        }
      }
    },
    "about.app.screenshotjoe": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots für App Store und Google Play: Mockups, Titel, 12 Sprachen und alle erforderlichen Größen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store and Google Play screenshots: device mockups, headlines, 12 languages and every required size."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturas para App Store y Google Play: maquetas, títulos, 12 idiomas y todos los tamaños requeridos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures pour l'App Store et Google Play : maquettes, titres, 12 langues et toutes les tailles requises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot per App Store e Google Play: mockup, titoli, 12 lingue e tutte le misure richieste."
          }
        }
      }
    },
    "about.app.sleeprec": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächtliche Audioanalyse, Geräuscherkennung und Schlafstatistiken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Night-time audio analysis, noise detection and sleep statistics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Análisis de audio nocturno, detección de ruidos y estadísticas del sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse audio nocturne, détection des bruits et statistiques de sommeil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisi acustica notturna, rilevamento dei rumori e statistiche sul sonno."
          }
        }
      }
    },
    "about.feature.display.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe Fenster per USB oder WLAN aufs iPhone. Scharf, flüssig, geringe Latenz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag windows onto your iPhone, over USB or Wi-Fi. Sharp, smooth, low latency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra ventanas al iPhone, por USB o Wi-Fi. Nítido, fluido y con baja latencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser des fenêtres sur l'iPhone, en USB ou Wi-Fi. Net, fluide, faible latence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le finestre sull'iPhone, via USB o Wi-Fi. Nitido, fluido, bassa latenza."
          }
        }
      }
    },
    "about.feature.display.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein echter zweiter Bildschirm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A real second display"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una segunda pantalla real"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vrai second écran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vero secondo schermo"
          }
        }
      }
    },
    "about.feature.private.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WLAN ist verschlüsselt und funktioniert nur mit gekoppelten Geräten. Keine Konten, keine Cloud, kein Tracking."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi is encrypted and works only with paired devices. No accounts, no cloud, no tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Wi-Fi está cifrado y solo funciona con dispositivos emparejados. Sin cuentas, nube ni seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Wi-Fi est chiffré et ne fonctionne qu'avec les appareils associés. Ni compte, ni cloud, ni suivi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Wi-Fi è cifrato e funziona solo con i dispositivi abbinati. Niente account, cloud o tracciamento."
          }
        }
      }
    },
    "about.feature.private.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
